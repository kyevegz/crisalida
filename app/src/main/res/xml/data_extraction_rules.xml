<?xml version="1.0" encoding="utf-8"?>
<!-- Lo guardado cifrado en el teléfono NO se copia a la nube ni a otro teléfono: la clave vive en el Keystore -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="crisalida_local_cifrado.xml"/>
        <exclude domain="sharedpref" path="crisalida_borradores.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="crisalida_local_cifrado.xml"/>
        <exclude domain="sharedpref" path="crisalida_borradores.xml"/>
    </device-transfer>
</data-extraction-rules>